[user]
	name = Ryan Bergeman
	email = code@ryanbergeman.com
[advice]
	detachedHead = false
[alias]
	amend = commit --amend --verbose
	ap = add --patch
	ch = checkout
	dc = diff --cached
	di = diff
	ds = diff --stat
	ff = merge --ff-only
	fixup = commit --fixup
	gl = log --extended-regexp --regexp-ignore-case --grep
	lg = log --decorate --graph --oneline
	sh = show
	squash = commit --verbose --squash
	ss = show --stat
	st = status --branch --short
	sw = switch
[color]
	ui = auto
[core]
	editor = vim
[fetch]
	prune = true
[push]
	default = simple
[rebase]
	autoSquash = true
[stash]
	showPatch = true
	showStat = false
